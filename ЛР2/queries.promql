up{job="web-app"}
sum(rate(http_requests_total{job="web-app"}[30s]))
sum(rate(http_requests_total{job="web-app",status="200"}[30s]))
sum(rate(http_requests_total{job="web-app",status=~"5.."}[30s]))
100 * sum(rate(http_requests_total{job="web-app",status=~"5.."}[30s])) / sum(rate(http_requests_total{job="web-app"}[30s]))
