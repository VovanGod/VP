histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job="web-app"}[30s]))) * 1000
sum(rate(container_cpu_usage_seconds_total{namespace="monitoring",pod=~"web-app-.*",id=~"/kubepods/[^/]+/pod[^/]+"}[1m])) * 100
sum(container_memory_working_set_bytes{namespace="monitoring",pod=~"web-app-.*",id=~"/kubepods/[^/]+/pod[^/]+"}) / 1024 / 1024
